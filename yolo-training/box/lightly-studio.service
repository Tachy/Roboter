[Unit]
Description=LightlyStudio (Unkrautroboter labeling loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tachy/lightly
ExecStart=/home/tachy/lightly/bin/studio-server.sh
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
